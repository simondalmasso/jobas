{
  "name": "jobas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev --test-scheduled",
    "dry-run": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "wrangler deploy",
    "verify": "npm test && npm run dry-run",
    "firebase:sites": "npx --yes firebase-tools hosting:sites:list --project jobas-d3c12",
    "firebase:deploy:redirect": "npx --yes firebase-tools deploy --only hosting --project jobas-d3c12"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  },
  "description": "Public job radar and personal job-search workspace for Argentina/LatAm.",
  "license": "MIT",
  "author": "Simón Dalmasso",
  "homepage": "https://jobas.web.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/simondalmasso/jobas.git"
  },
  "bugs": {
    "url": "https://github.com/simondalmasso/jobas/issues"
  },
  "keywords": [
    "jobs",
    "job-search",
    "career",
    "latam",
    "argentina",
    "cloudflare-workers",
    "mcp",
    "openrouter",
    "ai-coach"
  ],
  "engines": {
    "node": ">=22"
  }
}
